<Application x:Class="DentalMaintenance.Client.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="Windows/HealthcareDesktopWindow.xaml">
<Application.Resources>
 <Color x:Key="AccentColor">#35B7C8</Color><SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
 <SolidColorBrush x:Key="WindowBrush" Color="#101820"/><SolidColorBrush x:Key="PanelBrush" Color="#182632"/><SolidColorBrush x:Key="TextBrush" Color="#EAF2F7"/>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
 <Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="10,6"/></Style>
</Application.Resources></Application>