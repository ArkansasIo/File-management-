<UserControl x:Class="DentalMaintenance.Client.Windows.PatientChartPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Patient Chart" FontSize="26" FontWeight="Bold" Margin="0,0,0,14"/>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="Patient ID:" VerticalAlignment="Center"/><TextBox x:Name="PatientIdBox" Width="280" Margin="8,0,18,0"/><TextBlock Text="Specialty:" VerticalAlignment="Center"/><ComboBox x:Name="SpecialtyBox" Width="190" Margin="8,0,8,0"/><Button Content="Create template" Click="Create_Click"/></StackPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ListBox x:Name="SectionsList" DisplayMemberPath="Title" SelectionChanged="Sections_SelectionChanged" Margin="0,0,12,0"/><DataGrid x:Name="FieldsGrid" Grid.Column="1" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Field" Binding="{Binding Label}" IsReadOnly="True" Width="220"/><DataGridTextColumn Header="Value" Binding="{Binding Value,UpdateSourceTrigger=PropertyChanged}" Width="*"/><DataGridCheckBoxColumn Header="Required" Binding="{Binding Required}" IsReadOnly="True" Width="80"/></DataGrid.Columns></DataGrid></Grid>
<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button Content="Validate" Click="Validate_Click"/><Button Content="Print" Click="Print_Click"/><Button Content="Export text" Click="Export_Click"/></StackPanel>
</Grid></UserControl>