<Window x:Class="DentalMaintenance.Client.Windows.HealthcareDesktopWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DentalMaintenance Healthcare Workstation" Height="850" Width="1440" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}">
<DockPanel>
 <Border DockPanel.Dock="Top" Background="#0A1118" Padding="12"><DockPanel><TextBlock Text="DMS / HEALTHCARE WORKSTATION" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Overview" Click="Overview_Click"/><Button Content="Patients" Click="Patients_Click"/><Button Content="Charts" Click="Chart_Click"/><Button Content="Help" Click="Help_Click"/></StackPanel></DockPanel></Border>
 <Border DockPanel.Dock="Bottom" Background="#0A1118" Padding="8"><TextBlock Text="Development build 1.0.0 | Do not enter real patient data until security is configured."/></Border>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#14212B" Padding="12"><StackPanel><TextBlock Text="WORKSPACES" FontWeight="Bold" Margin="0,0,0,10"/><Button Content="Patient Directory" Click="Patients_Click"/><Button Content="Patient Charts" Click="Chart_Click"/><Button Content="Appointments" Click="Appointments_Click"/><Button Content="Encounters" Click="Encounters_Click"/><Button Content="Documents" Click="Documents_Click"/><Button Content="Care Profiles" Click="Profiles_Click"/><Button Content="Algorithms" Click="Algorithms_Click"/><Button Content="Settings" Click="Settings_Click"/></StackPanel></Border>
  <ScrollViewer Grid.Column="1" Padding="20"><StackPanel><TextBlock x:Name="PageTitle" Text="Overview" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock x:Name="PageSubtitle" Text="Multi-specialty healthcare operations" Margin="0,0,0,18"/><UniformGrid Columns="3"><Border Background="#1D3341" CornerRadius="8" Padding="16" Margin="4"><StackPanel><TextBlock Text="PATIENTS"/><TextBlock Text="Directory" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="#1D3341" CornerRadius="8" Padding="16" Margin="4"><StackPanel><TextBlock Text="CLINICAL"/><TextBlock Text="Charts" FontSize="22" FontWeight="Bold"/></StackPanel></Border><Border Background="#1D3341" CornerRadius="8" Padding="16" Margin="4"><StackPanel><TextBlock Text="OPERATIONS"/><TextBlock Text="Maintenance" FontSize="22" FontWeight="Bold"/></StackPanel></Border></UniformGrid><Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="18" Margin="4,18,4,4"><TextBlock x:Name="WorkspaceText" Text="Choose a workspace from the navigation." TextWrapping="Wrap" FontSize="14"/></Border></StackPanel></ScrollViewer>
  <Border Grid.Column="2" Background="#14212B" Padding="14"><StackPanel><TextBlock Text="INSPECTOR" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock Text="No patient selected"/><Separator Margin="0,14"/><TextBlock Text="API: not checked"/><TextBlock Text="Database: not checked"/><TextBlock Text="Authentication: not configured" TextWrapping="Wrap"/></StackPanel></Border>
 </Grid>
</DockPanel></Window>